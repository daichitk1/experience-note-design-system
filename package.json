{
  "name": "experience-note-design-system",
  "version": "0.1.0",
  "description": "体験ノートのデザインシステム: React部品、Tailwind CSS v4 theme、design tokens",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daichitk1/experience-note-design-system.git"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "src/theme.css",
    "tokens.json",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/theme.css",
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./tokens.json"
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:types && pnpm build:css",
    "build:js": "node scripts/build-js.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
